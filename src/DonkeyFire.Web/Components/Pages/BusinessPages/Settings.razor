@page "/b/{BusinessId:int}/settings"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject BusinessAccess Access
@inject FileStorage Storage
@inject ToastService Toasts
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SquareClient Square
@inject SquareSync Sync

<PageTitle>Settings · Donkey Fire</PageTitle>

<BusinessShell BusinessId="BusinessId" OnLoaded="Load" Context="ctx">
    <div class="page-head">
        <div>
            <div class="eyebrow">More</div>
            <h1 class="display-title">Settings</h1>
        </div>
    </div>

    <div class="tabs" role="tablist">
        <button type="button" role="tab" id="tab-details" aria-selected="@(tab == "details")" class="@(tab == "details" ? "active" : "")" @onclick="@(() => tab = "details")"><i class="bi bi-shop"></i> Business</button>
        <button type="button" role="tab" id="tab-square" aria-selected="@(tab == "square")" class="@(tab == "square" ? "active" : "")" @onclick="@(() => tab = "square")"><i class="bi bi-square"></i> Square</button>
        <button type="button" role="tab" id="tab-members" aria-selected="@(tab == "members")" class="@(tab == "members" ? "active" : "")" @onclick="@(() => tab = "members")"><i class="bi bi-people"></i> Members &amp; roles</button>
        @if (ctx.IsOwner)
        {
            <button type="button" role="tab" id="tab-danger" aria-selected="@(tab == "danger")" class="@(tab == "danger" ? "active" : "")" @onclick="@(() => tab = "danger")"><i class="bi bi-exclamation-octagon"></i> Danger zone</button>
        }
    </div>

    @if (tab == "details")
    {
        @if (!ctx.CanEdit)
        {
            <div class="alert alert-secondary small py-2">You have view access, so these settings are read only.</div>
        }
        <fieldset class="panel" disabled="@(!ctx.CanEdit)" style="max-width:820px">
            <div class="panel-head"><h2 class="section-title">Business details</h2></div>
            <div class="panel-body">
                <div class="form-grid">
                    <div class="full">
                        <label class="form-label" for="bs-name">Business name</label>
                        <input id="bs-name" class="form-control" @bind="form.Name" @bind:event="oninput" />
                        @if (string.IsNullOrWhiteSpace(form.Name)) { <div class="validation-message">Give the business a name.</div> }
                    </div>
                    <div><label class="form-label" for="bs-city">City</label><input id="bs-city" class="form-control" @bind="form.City" /></div>
                    <div><label class="form-label" for="bs-state">State</label><input id="bs-state" class="form-control" @bind="form.State" /></div>
                </div>

                <h3 class="settings-sub">Money</h3>
                <div class="form-grid">
                    <div><label class="form-label" for="bs-tax">Sales tax rate (%)</label><input id="bs-tax" type="number" min="0" max="30" step="0.25" class="form-control" @bind="form.SalesTaxPercent" /></div>
                    <div class="d-flex align-items-end"><div class="form-check"><input id="bs-incl" type="checkbox" class="form-check-input" @bind="form.PricesIncludeTax" /><label class="form-check-label" for="bs-incl">Menu prices include sales tax</label></div></div>
                    <div><label class="form-label" for="bs-card">Card processing fee (% of card sales)</label><input id="bs-card" type="number" min="0" max="10" step="0.1" class="form-control" @bind="form.CardFeePercent" />
                        <div class="small-muted mt-1">Set to 0 if you log processor fees as expenses instead.</div></div>
                    <div><label class="form-label" for="bs-burden">Payroll burden (% on top of wages)</label><input id="bs-burden" type="number" min="0" max="50" step="0.5" class="form-control" @bind="form.LaborBurdenPercent" />
                        <div class="small-muted mt-1">Employer payroll taxes, workers' comp. 0 for contract help.</div></div>
                    <div><label class="form-label" for="bs-food">Food cost target (% of price)</label><input id="bs-food" type="number" min="1" max="100" step="1" class="form-control" @bind="form.TargetFoodCostPercent" /></div>
                </div>

                <div class="mt-3">
                    <label class="form-label" for="bs-notes">Notes</label>
                    <textarea id="bs-notes" class="form-control" rows="4" @bind="form.Notes" placeholder="Permits and renewal dates, health inspection, insurance policy…"></textarea>
                </div>
            </div>
            @if (ctx.CanEdit)
            {
                <div class="bt-modal-foot">
                    <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">Undo changes</button>
                    <button type="button" class="btn btn-primary" disabled="@(saving || string.IsNullOrWhiteSpace(form.Name))" @onclick="() => SaveDetails(ctx)">
                        <i class="bi bi-check-lg"></i> @(saving ? "Saving…" : "Save settings")
                    </button>
                </div>
            }
        </fieldset>
    }
    else if (tab == "square")
    {
        <div class="panel" style="max-width:820px">
            <div class="panel-head">
                <h2 class="section-title">Square</h2>
                @if (ctx.Business.SquareLocationId is not null) { <StatusPill Kind="done" Text="Connected" /> }
                else if (Square.IsConfigured) { <StatusPill Kind="active" Text="Pick a location" /> }
                else { <StatusPill Kind="pending" Text="Not set up" /> }
            </div>
            <div class="panel-body">
                <p>Card sales rung up on Square come into Sales automatically: each item, cash or card, tips, and Square's actual processing fee. Items are matched to your menu by name, so they use up inventory just like sales rung up here. Ring up cash sales that don't go through Square on the Sales page.</p>
                @if (!Square.IsConfigured)
                {
                    <div class="alert alert-secondary small">
                        <strong>Set the access token on the server.</strong> In the <a href="https://developer.squareup.com/apps" target="_blank" rel="noopener">Square Developer Dashboard</a>, create an application, open <em>Credentials</em>, and copy the <em>Production access token</em>. Then:
                        <pre class="mono small mt-2 mb-1">fly secrets set Square__AccessToken=&lt;token&gt; --app donkeyfire</pre>
                        Locally, use <span class="mono">dotnet user-secrets set "Square:AccessToken" "&lt;token&gt;"</span>. Add <span class="mono">Square__Environment=sandbox</span> for a sandbox token. Never paste the token into chat or commit it.
                    </div>
                }
                else
                {
                    @if (Square.IsSandbox) { <div class="alert alert-warning small py-2">Using Square's sandbox (test data).</div> }
                    <div class="form-grid">
                        <div class="full">
                            <label class="form-label" for="sq-loc">Square location</label>
                            <div class="d-flex gap-2">
                                <select id="sq-loc" class="form-select" disabled="@(!ctx.CanEdit)" @bind="squareLocationId">
                                    <option value="">Not connected</option>
                                    @if (ctx.Business.SquareLocationId is { } cur && locations.All(l => l.Id != cur)) { <option value="@cur">@ctx.Business.SquareLocationName</option> }
                                    @foreach (var l in locations) { <option value="@l.Id">@(l.Name ?? l.Id)@(l.Status == "INACTIVE" ? " (inactive)" : "")</option> }
                                </select>
                                <button type="button" class="btn btn-outline-secondary text-nowrap" disabled="@squareBusy" @onclick="LoadLocations"><i class="bi bi-arrow-repeat"></i> Load locations</button>
                            </div>
                        </div>
                        <div><label class="form-label" for="sq-from">Import sales starting</label><input id="sq-from" type="date" class="form-control" disabled="@(!ctx.CanEdit || ctx.Business.SquareLastSyncAt is not null)" @bind="squareFrom" />
                            <div class="small-muted mt-1">@(ctx.Business.SquareLastSyncAt is null ? "Only used for the first sync." : "Set; later syncs pick up from the last one.")</div></div>
                        <div><span class="form-label d-block">Last synced</span><div class="pt-2">@(ctx.Business.SquareLastSyncAt is { } at ? at.ToLocalTime().ToString("MMM d, h:mm tt") : "Never")</div></div>
                    </div>
                    @if (ctx.CanEdit)
                    {
                        <div class="d-flex gap-2 flex-wrap mt-3">
                            <button type="button" class="btn btn-primary" disabled="@squareBusy" @onclick="() => SaveSquare(ctx)"><i class="bi bi-check-lg"></i> Save</button>
                            @if (ctx.Business.SquareLocationId is not null)
                            {
                                <button type="button" class="btn btn-accent" disabled="@squareBusy" @onclick="() => SyncNow(ctx)"><i class="bi bi-cloud-download"></i> @(squareBusy ? "Syncing…" : "Sync now")</button>
                            }
                        </div>
                    }
                    <p class="small-muted mt-3 mb-0">Sales sync when you press Sync on the Sales page. To sync on a timer too, set <span class="mono">Square__AutoSyncMinutes</span> (for example 15). Refunds come in as negative sales and put ingredients back. Square amounts are what the customer paid, so keep "Menu prices include sales tax" on.</p>
                }
            </div>
        </div>
    }
    else if (tab == "members")
    {
        <div class="panel">
            <div class="panel-head">
                <h2 class="section-title">Members</h2>
                <span class="small-muted">@members.Count(m => m.UserId != null) active · @members.Count(m => m.UserId == null) invited</span>
            </div>
            <div class="table-wrap">
                <table class="table-bt">
                    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Invited</th><th>Accepted</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var m in members)
                        {
                            var self = m.UserId == ctx.UserId;
                            <tr>
                                <td><strong>@(m.User?.DisplayName ?? "—")</strong>@if (self) { <span class="small-muted"> (you)</span> }</td>
                                <td class="text-nowrap">@m.Email</td>
                                <td>
                                    @if (ctx.IsOwner)
                                    {
                                        <label class="visually-hidden" for="@($"role-{m.Id}")">Role for @m.Email</label>
                                        <select @key="(m.Id, membersVersion)" id="@($"role-{m.Id}")" class="form-select form-select-sm role-select" value="@m.Role" @onchange="e => ChangeRole(ctx, m, e)">
                                            @foreach (var r in Roles)
                                            {
                                                <option value="@r">@r</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="pill pill-@(m.Role == BusinessRole.Owner ? "done" : m.Role == BusinessRole.Editor ? "active" : "ok")">@m.Role</span>
                                    }
                                </td>
                                <td><span class="pill pill-@(m.UserId is null ? "pending" : "done")">@(m.UserId is null ? "Invited" : "Active")</span></td>
                                <td class="text-nowrap">@m.InvitedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                                <td class="text-nowrap">@(m.AcceptedAt?.ToLocalTime().ToString("MMM d, yyyy") ?? "—")</td>
                                <td class="row-actions">
                                    @if (ctx.IsOwner)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Remove @m.Email" aria-label="Remove @m.Email" @onclick="() => Remove(ctx, m)"><i class="bi bi-person-dash"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="panel-body border-top">
                <div class="role-help">
                    <div><strong>Viewer</strong><span>Read only. Can see everything and see every report.</span></div>
                    <div><strong>Editor</strong><span>Can add and change business data: sales, expenses, menu, inventory and shifts.</span></div>
                    <div><strong>Owner</strong><span>Everything an editor can do, plus manages members and can delete the business.</span></div>
                </div>
            </div>
        </div>

        @if (ctx.IsOwner)
        {
            <div class="panel">
                <div class="panel-head"><h2 class="section-title">Invite someone</h2></div>
                <div class="panel-body">
                    <div class="invite-row">
                        <div class="flex-grow-1">
                            <label class="form-label" for="inv-email">Email (their Google account)</label>
                            <input id="inv-email" type="email" class="form-control" placeholder="name@gmail.com" @bind="inviteEmail" @bind:event="oninput" @onkeydown="InviteKey" />
                        </div>
                        <div>
                            <label class="form-label" for="inv-role">Role</label>
                            <select id="inv-role" class="form-select" @bind="inviteRole">
                                @foreach (var r in Roles) { <option value="@r">@r</option> }
                            </select>
                        </div>
                        <div class="d-flex align-items-end">
                            <button type="button" id="inv-send" class="btn btn-accent" disabled="@(!LooksLikeEmail(inviteEmail))" @onclick="Invite"><i class="bi bi-person-plus"></i> Invite</button>
                        </div>
                    </div>
                    <p class="small-muted mt-2 mb-2">People who already use Donkey Fire get access right away. Anyone else gets access the first time they sign in with Google using this email address.</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CopyLoginLink"><i class="bi bi-link-45deg"></i> Copy sign-in link</button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <p class="small-muted mt-2">Only owners can invite people or change roles.</p>
        }
    }
    else if (tab == "danger" && ctx.IsOwner)
    {
        <div class="panel danger-panel">
            <div class="panel-head"><h2 class="section-title">Delete this business</h2></div>
            <div class="panel-body">
                <p>This permanently deletes <strong>@ctx.Business.Name</strong> for everyone: sales, expenses and receipts, events, menu and recipes, inventory, employees and shifts. Uploaded receipts are removed from storage. This can't be undone.</p>
                <p class="small-muted">Consider exporting CSVs from each page first.</p>
                <label class="form-label" for="del-confirm">Type the business name <span class="mono">@ctx.Business.Name</span> to confirm</label>
                <div class="invite-row">
                    <input id="del-confirm" class="form-control" autocomplete="off" @bind="deleteConfirm" @bind:event="oninput" />
                    <button type="button" id="del-go" class="btn btn-danger" disabled="@(deleting || deleteConfirm.Trim() != ctx.Business.Name.Trim())" @onclick="() => DeleteBusiness(ctx)">
                        <i class="bi bi-trash"></i> @(deleting ? "Deleting…" : "Delete business")
                    </button>
                </div>
            </div>
        </div>
    }

    <ConfirmDialog @ref="confirm" />

    <style>
        .settings-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 1rem; align-items: start; }
        @@media (max-width: 1000px) { .settings-layout { grid-template-columns: 1fr; } }
        fieldset.panel { min-width: 0; margin: 0; padding: 0; }
        fieldset.panel:disabled .form-control, fieldset.panel:disabled .form-select { background: transparent; border-style: dashed; }
        .settings-layout > .panel { margin-top: 0; }
        .settings-sub { font-size: .72rem; letter-spacing: .09em; text-transform: uppercase; color: var(--bt-muted); font-weight: 700; margin: 1.4rem 0 .6rem; padding-top: .9rem; border-top: 1px solid var(--bt-line); }
        .form-grid.four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        @@media (max-width: 760px) { .form-grid.four { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        .cover-preview { aspect-ratio: 16 / 10; border-radius: 8px; overflow: hidden; background: #25313a; border: 1px solid var(--bt-line); }
        .cover-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .cover-preview .ph { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .3rem; color: #93a3af; }
        .cover-preview .ph i { font-size: 2rem; }
        .role-select { width: auto; min-width: 7.5rem; }
        .role-help { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; font-size: .85rem; }
        .role-help div { display: flex; flex-direction: column; gap: .1rem; }
        .role-help span { color: var(--bt-muted); }
        @@media (max-width: 760px) { .role-help { grid-template-columns: 1fr; } }
        .invite-row { display: flex; gap: .6rem; flex-wrap: wrap; }
        .invite-row > .flex-grow-1, .invite-row > input { flex: 1 1 240px; min-width: 0; }
        .danger-panel { border-color: color-mix(in srgb, var(--bt-over) 45%, var(--bt-line)); }
        .danger-panel .panel-head { background: color-mix(in srgb, var(--bt-over) 8%, transparent); }
        .danger-panel .section-title { color: var(--bt-over); }
    </style>
</BusinessShell>

@code {
    [Parameter] public int BusinessId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }

    private static readonly BusinessRole[] Roles = [BusinessRole.Viewer, BusinessRole.Editor, BusinessRole.Owner];
    private string tab = "details";
    private Business form = new();
    private bool saving, deleting;
    private List<BusinessMember> members = new();
    private int membersVersion;
    private string inviteEmail = "";
    private BusinessRole inviteRole = BusinessRole.Editor;
    private string deleteConfirm = "";
    private ConfirmDialog confirm = default!;
    private List<SquareLocation> locations = new();
    private string squareLocationId = "";
    private DateOnly? squareFrom;
    private bool squareBusy;

    private async Task Load(BusinessContext c)
    {
        squareLocationId = c.Business.SquareLocationId ?? "";
        squareFrom = c.Business.SquareSyncFrom ?? DateOnly.FromDateTime(DateTime.Today.AddDays(-30));
        if (TabQuery is "members" or "details" or "square" || (TabQuery == "danger" && c.IsOwner)) tab = TabQuery;
        await ResetFormAsync();
        await LoadMembers();
    }

    private async Task ResetFormAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        form = await db.Businesses.AsNoTracking().FirstAsync(x => x.Id == BusinessId);
    }

    private async Task ResetForm()
    {
        await ResetFormAsync();
        Toasts.Show("Changes undone.");
    }

    private async Task SaveDetails(BusinessContext c)
    {
        if (!c.CanEdit || string.IsNullOrWhiteSpace(form.Name)) return;
        if (form.SalesTaxPercent < 0 || form.CardFeePercent < 0 || form.LaborBurdenPercent < 0 || form.TargetFoodCostPercent is <= 0 or > 100)
        {
            Toasts.Error("Percentages can't be negative, and the food cost target must be between 1 and 100%.");
            return;
        }
        saving = true;
        try
        {
            await Access.RequireAsync(BusinessId, BusinessRole.Editor);
            await using var db = await DbFactory.CreateDbContextAsync();
            var b = await db.Businesses.FirstAsync(x => x.Id == BusinessId);
            b.Name = form.Name.Trim();
            b.City = string.IsNullOrWhiteSpace(form.City) ? null : form.City.Trim();
            b.State = string.IsNullOrWhiteSpace(form.State) ? null : form.State.Trim();
            b.SalesTaxPercent = form.SalesTaxPercent;
            b.PricesIncludeTax = form.PricesIncludeTax;
            b.CardFeePercent = form.CardFeePercent;
            b.LaborBurdenPercent = form.LaborBurdenPercent;
            b.TargetFoodCostPercent = form.TargetFoodCostPercent;
            b.Notes = string.IsNullOrWhiteSpace(form.Notes) ? null : form.Notes.Trim();
            await db.SaveChangesAsync();
            c.Business = b;
            Toasts.Show("Settings saved.");
            if (c.Reload is not null) await c.Reload();
        }
        finally { saving = false; }
    }

    private async Task LoadLocations()
    {
        squareBusy = true;
        try
        {
            locations = await Square.GetLocationsAsync();
            if (locations.Count == 0) Toasts.Error("Square didn't return any locations for this token.");
            else if (squareLocationId == "" && locations.Count(l => l.Status != "INACTIVE") == 1) squareLocationId = locations.First(l => l.Status != "INACTIVE").Id;
        }
        catch (Exception ex) when (ex is SquareException or HttpRequestException or TaskCanceledException) { Toasts.Error(ex is SquareException ? ex.Message : "Couldn't reach Square."); }
        finally { squareBusy = false; }
    }

    private async Task SaveSquare(BusinessContext c)
    {
        await Access.RequireAsync(BusinessId, BusinessRole.Editor);
        var loc = locations.FirstOrDefault(l => l.Id == squareLocationId);
        await using var db = await DbFactory.CreateDbContextAsync();
        var b = await db.Businesses.FirstAsync(x => x.Id == BusinessId);
        if (squareLocationId == "") { b.SquareLocationId = null; b.SquareLocationName = null; }
        else if (loc is not null) { b.SquareLocationId = loc.Id; b.SquareLocationName = loc.Name; b.SquareTimeZone = loc.Timezone; }
        if (b.SquareLastSyncAt is null) b.SquareSyncFrom = squareFrom;
        await db.SaveChangesAsync();
        Toasts.Show(b.SquareLocationId is null ? "Square disconnected. Imported sales are kept." : $"Square connected to {b.SquareLocationName ?? "your location"}.");
        if (c.Reload is not null) await c.Reload();
    }

    private async Task SyncNow(BusinessContext c)
    {
        squareBusy = true;
        try { Toasts.Show((await Sync.SyncAsync(BusinessId)).Summary); }
        catch (Exception ex) when (ex is SquareException or HttpRequestException or TaskCanceledException) { Toasts.Error(ex is SquareException ? ex.Message : "Couldn't reach Square."); }
        finally { squareBusy = false; }
        if (c.Reload is not null) await c.Reload();
    }

    private async Task LoadMembers()
    {
        membersVersion++;
        await using var db = await DbFactory.CreateDbContextAsync();
        members = (await db.BusinessMembers.AsNoTracking().Where(m => m.BusinessId == BusinessId).Include(m => m.User).ToListAsync())
            .OrderByDescending(m => m.Role).ThenBy(m => m.UserId is null).ThenBy(m => m.User?.DisplayName ?? m.Email).ToList();
    }

    private static bool LooksLikeEmail(string? v) =>
        !string.IsNullOrWhiteSpace(v) && System.Net.Mail.MailAddress.TryCreate(v.Trim(), out var a) && a.Address == v.Trim() && a.Host.Contains('.');

    private async Task InviteKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && LooksLikeEmail(inviteEmail)) await Invite();
    }

    private async Task Invite()
    {
        var email = inviteEmail.Trim().ToLowerInvariant();
        if (!LooksLikeEmail(email)) { Toasts.Error("Enter a valid email address."); return; }
        if (!await IsOwnerNow()) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.BusinessMembers.AnyAsync(m => m.BusinessId == BusinessId && m.Email == email))
        {
            Toasts.Error($"{email} is already a member or has been invited.");
            return;
        }
        var user = await db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Email.ToLower() == email);
        if (user is not null && await db.BusinessMembers.AnyAsync(m => m.BusinessId == BusinessId && m.UserId == user.Id))
        {
            Toasts.Error($"{user.DisplayName} is already a member.");
            return;
        }
        db.BusinessMembers.Add(new BusinessMember
        {
            BusinessId = BusinessId, Email = email, Role = inviteRole, UserId = user?.Id, AcceptedAt = user is null ? null : DateTime.UtcNow,
        });
        await db.SaveChangesAsync();
        inviteEmail = "";
        Toasts.Show(user is null
            ? $"Invited {email}. They'll get access when they first sign in with Google."
            : $"Added {user.DisplayName} as {inviteRole}.");
        await LoadMembers();
    }

    private int ActiveOwners => members.Count(m => m.Role == BusinessRole.Owner && m.UserId != null);

    private async Task ChangeRole(BusinessContext c, BusinessMember m, ChangeEventArgs e)
    {
        if (!Enum.TryParse<BusinessRole>(e.Value?.ToString(), out var role) || role == m.Role) return;
        if (m.Role == BusinessRole.Owner && m.UserId != null && ActiveOwners <= 1)
        {
            Toasts.Error("A business needs at least one owner. Make someone else an owner first.");
            await LoadMembers(); // puts the select back
            return;
        }
        if (!await IsOwnerNow()) { await LoadMembers(); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.BusinessMembers.Where(x => x.Id == m.Id && x.BusinessId == BusinessId).ExecuteUpdateAsync(x => x.SetProperty(y => y.Role, role));
        Toasts.Show($"{m.User?.DisplayName ?? m.Email} is now {(role == BusinessRole.Viewer ? "a" : "an")} {role}.");
        if (m.UserId == c.UserId)
        {
            // Our own access changed; reload so menus and permissions match.
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
            return;
        }
        await LoadMembers();
    }

    private async Task Remove(BusinessContext c, BusinessMember m)
    {
        var self = m.UserId == c.UserId;
        if (m.Role == BusinessRole.Owner && m.UserId != null && ActiveOwners <= 1)
        {
            Toasts.Error(self
                ? "You're the only owner. Make someone else an owner before removing yourself, or delete the business instead."
                : "A business needs at least one owner.");
            return;
        }
        var who = m.User?.DisplayName ?? m.Email;
        var question = self
            ? $"Remove yourself from {c.Business.Name}? You'll lose access until an owner invites you again."
            : m.UserId is null ? $"Cancel the invite for {m.Email}?" : $"Remove {who} from {c.Business.Name}? They'll lose access right away.";
        if (!await confirm.AskAsync(question, self ? "Leave this business?" : "Remove member?", self ? "Leave business" : "Remove")) return;
        if (!await IsOwnerNow()) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.BusinessMembers.Where(x => x.Id == m.Id && x.BusinessId == BusinessId).ExecuteDeleteAsync();
        if (self)
        {
            Nav.NavigateTo("/", forceLoad: true);
            return;
        }
        Toasts.Show(m.UserId is null ? $"Invite for {m.Email} cancelled." : $"Removed {who}.");
        await LoadMembers();
    }

    private async Task CopyLoginLink()
    {
        var ok = await JS.InvokeAsync<bool>("bt.copy", Nav.ToAbsoluteUri("/login").ToString());
        if (ok) Toasts.Show("Sign-in link copied.");
        else Toasts.Error($"Couldn't copy. The link is {Nav.ToAbsoluteUri("/login")}");
    }

    private async Task<bool> IsOwnerNow()
    {
        if (await Access.GetRoleAsync(BusinessId) == BusinessRole.Owner) return true;
        Toasts.Error("Only owners can manage members.");
        return false;
    }

    // ---------- Danger zone ----------

    private async Task DeleteBusiness(BusinessContext c)
    {
        if (deleteConfirm.Trim() != c.Business.Name.Trim()) return;
        if (await Access.GetRoleAsync(BusinessId) != BusinessRole.Owner) { Toasts.Error("Only owners can delete the business."); return; }
        deleting = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var paths = (await db.Files.AsNoTracking().Where(f => f.BusinessId == BusinessId).ToListAsync()).Select(Storage.GetFullPath).ToList();
            // Rows first (everything cascades from the business), then the files on disk.
            await db.Businesses.Where(p => p.Id == BusinessId).ExecuteDeleteAsync();
            foreach (var path in paths)
            {
                try { if (File.Exists(path)) File.Delete(path); } catch (IOException) { } catch (UnauthorizedAccessException) { }
            }
            foreach (var dir in paths.Select(Path.GetDirectoryName).Distinct())
            {
                try { if (dir is not null && Directory.Exists(dir) && !Directory.EnumerateFileSystemEntries(dir).Any()) Directory.Delete(dir); } catch (IOException) { }
            }
            Toasts.Show($"Deleted {c.Business.Name}.");
            Nav.NavigateTo("/");
        }
        catch (Exception ex) when (ex is DbUpdateException or Microsoft.Data.Sqlite.SqliteException)
        {
            deleting = false;
            Toasts.Error($"Couldn't delete the business: {ex.GetBaseException().Message}");
        }
    }
}
