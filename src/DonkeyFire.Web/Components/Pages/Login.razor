@page "/login"
@attribute [AllowAnonymous]
@layout MainLayout
@inject AuthOptionsInfo AuthInfo

<PageTitle>Sign in · Donkey Fire</PageTitle>

<div class="login-wrap">
    <section class="login-art">
        <div class="brand p-0"><span class="brand-mark"><i class="bi bi-fire"></i></span>Donkey Fire</div>
        <div>
            <h1>Every sale, every shift, every bun.</h1>
            <p class="mt-3">Run the concession business: ring up sales by event, log expenses and receipts, track inventory against your recipes, and see labor and profit for every day you open the window.</p>
        </div>
        <div class="small" style="color:#7f909c">Sales · Expenses · Inventory · Menu costs · Labor</div>
    </section>
    <section class="login-form">
        <div>
            <div class="eyebrow">Welcome</div>
            <h2 class="display-title" style="font-size:2rem">Sign in to Donkey Fire</h2>
        </div>
        @if (Error == "google-not-configured")
        {
            <div class="alert alert-warning small mb-0">Google sign-in isn't configured on this server yet. See the README for setting the Google client ID and secret.</div>
        }
        @if (Error == "not-allowed")
        {
            <div class="alert alert-warning small mb-0" role="alert">That Google account isn't allowed to sign in here. Ask the business owner to invite your email address.</div>
        }
        @if (AuthInfo.GoogleConfigured)
        {
            <a class="btn-google text-decoration-none" href="@($"/auth/login/google?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}")" target="_top">
                <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C41.5 35.3 44 30 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
                Continue with Google
            </a>
        }
        else
        {
            <div class="alert alert-secondary small mb-0">Google sign-in is not configured yet.</div>
        }
        @if (AuthInfo.DevLoginEnabled)
        {
            <form method="post" action="@($"/auth/dev-login?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}")" data-enhance="false">
                <button class="btn btn-outline-secondary w-100" type="submit"><i class="bi bi-terminal"></i> Developer sign-in (local only)</button>
            </form>
        }
        <p class="small-muted mb-0">Each person signs in with their own Google account. Owners can invite others by email from Settings.</p>
    </section>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
