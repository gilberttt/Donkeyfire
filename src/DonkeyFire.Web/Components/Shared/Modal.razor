@* Simple dialog. Show it with @bind-Open or by toggling Open from the parent. *@
@if (Open)
{
    <div class="bt-modal-backdrop" @onclick="BackdropClick">
        <div class="bt-modal @Size" role="dialog" aria-modal="true" aria-label="@Title" @onclick:stopPropagation="true">
            <div class="bt-modal-head">
                <h2>@if (!string.IsNullOrEmpty(Icon)) { <i class="bi @Icon"></i> }@Title</h2>
                <button type="button" class="btn btn-icon btn-outline-secondary border-0" aria-label="Close" @onclick="Close"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="bt-modal-body">@ChildContent</div>
            @if (Footer is not null)
            {
                <div class="bt-modal-foot">@Footer</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string Size { get; set; } = "";
    [Parameter] public bool CloseOnBackdrop { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    public async Task Close()
    {
        Open = false;
        await OpenChanged.InvokeAsync(false);
    }

    private async Task BackdropClick()
    {
        if (CloseOnBackdrop) await Close();
    }
}
